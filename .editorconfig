# EditorConfig for EnumWrapper.SourceGenerators
root = true

[*]
indent_style = space
indent_size = 4
charset = utf-8-bom
trim_trailing_whitespace = true
insert_final_newline = true
end_of_line = crlf

[*.{cs,csproj,slnx,xaml,xml,yml}]
indent_size = 4

[*.{md,txt}]
trim_trailing_whitespace = false

[*.yml]
indent_size = 2
